{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext",
    "rootDir": "src", "outDir": "dist", "strict": true, "declaration": true, "skipLibCheck": true,
    "rewriteRelativeImportExtensions": true, "noEmitOnError": true, "verbatimModuleSyntax": true
  },
  "include": ["src/**/*.ts"]
}
